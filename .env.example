# === 필수 ===
# (API 키는 필요 없습니다. 모델은 구독 로그인된 CLI(claude/codex/gemini)와 로컬 모델로 호출합니다.)

# 디스코드 봇 토큰 (Developer Portal → 내 앱 → Bot → Reset Token)
DISCORD_TOKEN=
# 연구자 본인의 디스코드 사용자 ID. 이 ID 의 명령만 실행됩니다(코드를 실행하는 봇이므로 필수 안전장치).
DISCORD_OWNER_ID=
# 서버(길드) ID. 넣으면 슬래시 명령이 즉시 등록됩니다.
DISCORD_GUILD_ID=

# === 선택 ===
# 채널 이름(없으면 봇이 만들려고 시도합니다. '채널 관리' 권한 필요)
INTAKE_CHANNEL=실험요청
PROGRESS_CHANNEL=진행현황
REPORT_CHANNEL=보고서

# === 모델 경로 (과금 없는 구성) ===
# 역할마다 우선순위 목록. 앞 백엔드가 막히면(한도 소진·로그인 풀림·서버 꺼짐) 다음으로 자동 전환합니다.
# 형식: 백엔드[/모델] 를 쉼표로 이어 씁니다.
#   claude  = `claude -p` (Claude 구독 로그인)      모델 별칭: opus, sonnet
#   codex   = `codex exec` (ChatGPT/Codex 구독 로그인)
#   gemini  = `gemini -p` (Google 로그인)
#   local   = OpenAI 호환 로컬 서버 (Ollama 등)     모델: LOCAL_MODEL 또는 local/모델이름
#   api     = Anthropic API (토큰 과금! 기본 경로에는 없음. 쓰려면 ANTHROPIC_API_KEY 와 함께 직접 적을 것)
# 아래는 기본값입니다. 바꾸고 싶은 줄만 주석을 풀어 고치세요.
# ROUTE_DIRECTOR=claude/sonnet, gemini, local
# ROUTE_LINGUIST=claude/opus, gemini, codex
# ROUTE_COGSCI=claude/opus, gemini, codex
# ROUTE_LM=claude/opus, gemini, codex
# ROUTE_DEVELOPER=codex, claude/sonnet, local
# ROUTE_PRACTITIONER=local, gemini, claude/sonnet
# ROUTE_DOCUMENTER=local, claude/sonnet, gemini
# ROUTE_TESTER=claude/opus, codex, gemini

# 로컬 모델 서버 (Ollama 기본 주소). 모델 이름은 `ollama list` 에 보이는 이름.
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=

# CLI 호출 때 ANTHROPIC/OPENAI/GEMINI 등 *_API_KEY 환경변수를 지워서(기본) 구독 로그인만 쓰게 합니다.
# 1 로 바꾸면 지우지 않습니다 → CLI 가 API 과금 경로를 쓸 수 있으니 주의.
KEEP_API_KEYS=0
# CLI 한 번 호출 최대 시간(분)
CLI_TIMEOUT_MIN=20
# CLI 경로를 바꿔야 할 때만(launchd 에서 PATH 에 없을 때 등)
# CLAUDE_BIN=/opt/homebrew/bin/claude
# CODEX_BIN=/opt/homebrew/bin/codex
# GEMINI_BIN=/opt/homebrew/bin/gemini

# 샌드박스: docker(권장, 격리) | host(맥에서 직접 실행, 격리 없음)
SANDBOX_BACKEND=docker
DOCKER_IMAGE=research-lab-sandbox:latest
SANDBOX_CPUS=4
SANDBOX_MEMORY=10g

# 동시에 진행할 실험 수 (노트북이면 1 권장)
MAX_CONCURRENT=1
# 실험 1건당 토큰 상한(모든 백엔드 합산 입력+출력, 안전장치). 넘으면 일시정지하고 /resume 으로 연장
TOKEN_BUDGET_PER_EXPERIMENT=3000000
# 명령 1회 최대 실행 시간(분) / 이 시간을 넘길 것으로 예상되면 사전 승인 요구(분)
RUN_TIMEOUT_MIN=120
APPROVAL_RUNTIME_MIN=60
# 네트워크 정책: ask(승인 필요) | allow | deny
NETWORK_POLICY=ask

# 연구실 데이터 위치(기본: 이 폴더의 workspace/)
# LAB_HOME=
